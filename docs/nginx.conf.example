# LanShare Nginx 反代示例（HTTPS 由 Nginx 终止，LanShare 只监听 HTTP）
# 放入 /etc/nginx/conf.d/lanshare.conf 后 nginx -t && systemctl reload nginx
# 把 share.example.com 和证书路径替换成自己的。

server {
    listen 80;
    server_name share.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name share.example.com;

    ssl_certificate     /etc/nginx/certs/share.example.com.pem;
    ssl_certificate_key /etc/nginx/certs/share.example.com.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    # 必须 >= LanShare 里设置的上传上限（默认 2 GiB）
    client_max_body_size 2g;

    location / {
        proxy_pass http://127.0.0.1:8910;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 大文件上传/下载不要整包缓冲
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
