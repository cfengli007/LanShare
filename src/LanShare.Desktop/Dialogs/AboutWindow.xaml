<Window x:Class="LanShare.Desktop.Dialogs.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Icon="pack://application:,,,/LanShare;component/Assets/app.ico"
        Title="关于 LanShare" Height="560" Width="660"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        Language="zh-CN" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!--
      关于窗口。骨架固定三段：自绘标题栏 40 / 内容 * / 按钮栏 64（见 docs/UI-CONTRACT.md 第六节）。
      坑：WindowStyle=None 之后系统按钮全没了，所以关闭按钮和拖动都必须自己实现；
          关闭按钮必须 IsHitTestVisibleInChrome=True，否则点击会被 WindowChrome 吃掉。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBg}" MouseLeftButtonDown="OnDrag">
            <TextBlock Text="关于 LanShare" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
            <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right" Width="44" Height="40"
                    Click="OnClose" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    ToolTip="关闭">
                <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="{DynamicResource Fg}" StrokeThickness="1.2"/>
            </Button>
        </Grid>

        <!-- 内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20,24,20">
            <StackPanel>

                <!-- 应用标识 -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 用 Rectangle + ImageBrush 而不是 Border+Image：Border 不会把子元素裁成圆角 -->
                    <Rectangle Grid.Column="0" Width="48" Height="48" RadiusX="10" RadiusY="10">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="pack://application:,,,/LanShare;component/Assets/app-256.png" Stretch="UniformToFill"/>
                        </Rectangle.Fill>
                    </Rectangle>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LanShare" FontSize="20" FontWeight="SemiBold"/>
                            <Border Style="{StaticResource BadgeAccent}" Margin="8,0,0,0">
                                <TextBlock Text="内网快传" Style="{StaticResource BadgeTextAccent}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="VersionText" Style="{StaticResource PageSubtitle}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 信息表 -->
                <TextBlock Text="信息" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="86"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="技术栈" FontSize="12"
                                   Foreground="{DynamicResource FgDim}" Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="WPF / .NET 8（Windows 原生）" FontSize="12"
                                   Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Web 端" FontSize="12"
                                   Foreground="{DynamicResource FgDim}" Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Kestrel + Bootstrap（手机用浏览器直连）" FontSize="12"
                                   Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="许可" FontSize="12"
                                   Foreground="{DynamicResource FgDim}" Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="GPL-3.0" FontSize="12" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="项目地址" FontSize="12"
                                   Foreground="{DynamicResource FgDim}" Margin="0,0,16,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="RepoText" FontSize="12"
                                   Foreground="{DynamicResource Accent}" Cursor="Hand"
                                   TextTrimming="CharacterEllipsis" ToolTip="点击打开项目主页"
                                   MouseLeftButtonDown="OnOpenRepo"/>
                    </Grid>
                </Border>

                <!-- 许可声明 -->
                <TextBlock Text="许可" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="CopyrightText" FontSize="12" Margin="0,0,0,10"/>
                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LicenseText" FontSize="12" LineHeight="19"
                                       Foreground="{DynamicResource FgDim}" TextWrapping="Wrap"
                                       Text="本程序是自由软件：你可以依据自由软件基金会发布的 GNU 通用公共许可证第 3 版（或你选择的任何更新版本）的条款重新分发和/或修改它。&#10;&#10;本程序基于“有用”的目的分发，但不提供任何担保，甚至不提供适销性或特定用途适用性的默示担保。详见 GNU 通用公共许可证。&#10;&#10;完整许可全文见安装目录或仓库根目录的 LICENSE 文件。"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 按钮栏 -->
        <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0" Padding="20,0">
            <Grid>
                <TextBlock x:Name="HintText" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis"
                           Margin="0,0,220,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="查看许可证" Style="{StaticResource FlatButton}" Click="OnViewLicense"
                            Margin="0,0,8,0" Padding="16,6"/>
                    <Button Content="打开项目主页" Style="{StaticResource PrimaryButton}" Click="OnOpenRepoClick"
                            Padding="18,6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
