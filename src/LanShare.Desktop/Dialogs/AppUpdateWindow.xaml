<Window x:Class="LanShare.Desktop.Dialogs.AppUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Icon="pack://application:,,,/LanShare;component/Assets/app.ico"
        Title="检查更新" Height="600" Width="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        Language="zh-CN" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!--
      检查更新 / 下载安装包。骨架：标题栏 40 / 内容 * / 按钮栏 64。
      三块内容：状态卡（标题 + 详情 + 进度条）、版本信息卡、更新说明卡。

      数据来源 Services/Update：UpdateService.Instance（检查、下载、启动安装器），
      SelfUpdater 只提供版本号与 URL 常量。UI 层不直接发 HTTP。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBg}" MouseLeftButtonDown="OnDrag">
            <TextBlock Text="检查更新" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
            <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right" Width="44" Height="40"
                    Click="OnClose" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="关闭">
                <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="{DynamicResource Fg}" StrokeThickness="1.2"/>
            </Button>
        </Grid>

        <!-- 内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18,24,18">
            <StackPanel>

                <!-- 状态卡 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="StatusTitle" FontSize="15" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Text="尚未检查更新"/>
                        <TextBlock x:Name="StatusDetail" Style="{StaticResource PageSubtitle}"
                                   Margin="0,6,0,0" Text="点击右下角「检查更新」开始。"/>
                        <ProgressBar x:Name="Bar" Margin="0,12,0,0" Minimum="0" Maximum="100"
                                     Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- 版本信息 -->
                <TextBlock Text="版本信息" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="72"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="当前版本" FontSize="12"
                                   Foreground="{DynamicResource FgDim}" Margin="0,0,16,8"/>
                        <TextBlock x:Name="CurrentVersionText" Grid.Row="0" Grid.Column="1"
                                   FontSize="12" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="最新版本" FontSize="12"
                                   Foreground="{DynamicResource FgDim}" Margin="0,0,16,8"/>
                        <TextBlock x:Name="LatestVersionText" Grid.Row="1" Grid.Column="1"
                                   FontSize="12" Margin="0,0,0,8" Text="—"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="项目地址" FontSize="12"
                                   Foreground="{DynamicResource FgDim}" Margin="0,0,16,0"/>
                        <TextBlock x:Name="RepoText" Grid.Row="2" Grid.Column="1" FontSize="12"
                                   Foreground="{DynamicResource Accent}" Cursor="Hand"
                                   TextTrimming="CharacterEllipsis" ToolTip="点击打开项目主页"
                                   MouseLeftButtonDown="OnOpenRepo"/>
                    </Grid>
                </Border>

                <!-- 更新说明 -->
                <TextBlock Text="更新说明" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="ReleaseNotes" IsReadOnly="True" TextWrapping="Wrap"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 FontSize="12" VerticalScrollBarVisibility="Disabled"
                                 Text="（检查后显示）"/>
                    </ScrollViewer>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 按钮栏 -->
        <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0" Padding="20,0">
            <Grid>
                <TextBlock x:Name="HintText" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis"
                           Margin="0,0,260,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="关闭" Style="{StaticResource FlatButton}" Click="OnClose"
                            Margin="0,0,8,0" Padding="18,6" IsCancel="True"/>
                    <Button x:Name="ActionButton" Content="检查更新" Style="{StaticResource PrimaryButton}"
                            Click="OnAction" Padding="22,6" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
