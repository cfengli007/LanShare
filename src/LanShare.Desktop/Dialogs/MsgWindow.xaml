<Window x:Class="LanShare.Desktop.Dialogs.MsgWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/LanShare;component/Assets/app.ico"
        Title="LanShare"
        Width="620" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        Language="zh-CN" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!--
      深色/浅色自适应消息框，替代系统 MessageBox。
      要点：
        • 左侧 4px 色条按 Info/Warning/Error 走 Accent/Warn/Danger，颜色 + 文字双编码
        • 正文用只读 TextBox（不是 TextBlock），异常堆栈才能选中复制
        • 只读 TextBox 的模板触发器会把背景改成 Card，所以外面那层容器也用 Card，
          两层同色才能看起来是一整块（改容器色会露出一圈边）
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="KindBar" Grid.Column="0" Background="{DynamicResource Accent}"/>

        <Grid Grid.Column="1" Margin="20,18,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock x:Name="TitleText" Grid.Row="0" Text="提示"
                       FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <!-- 正文：只读 TextBox，可选中复制 -->
            <Border Grid.Row="1" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="1" CornerRadius="8" Padding="14,12">
                <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBox x:Name="BodyText" IsReadOnly="True" TextWrapping="Wrap"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             Foreground="{DynamicResource Fg}" FontSize="12"
                             VerticalScrollBarVisibility="Auto"/>
                </ScrollViewer>
            </Border>

            <!-- 按钮行 -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Button x:Name="CopyButton" Content="复制全部" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Left" Click="OnCopy" Padding="14,6"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="取消" Style="{StaticResource FlatButton}"
                            Click="OnCancel" Margin="0,0,8,0" Padding="18,6"
                            Visibility="Collapsed" IsCancel="True"/>
                    <Button x:Name="OkButton" Content="确定" Style="{StaticResource PrimaryButton}"
                            Click="OnOk" Padding="22,6" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
