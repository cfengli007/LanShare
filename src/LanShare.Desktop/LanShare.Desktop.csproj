<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>LanShare</AssemblyName>
    <RootNamespace>LanShare.Desktop</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- 界面层不再依赖 WPF-UI：整套视觉改为自绘体系（见 docs/UI-DESIGN.md）。
         保留 H.NotifyIcon 只有一个用途：托盘图标。 -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-256.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LanShare.Core\LanShare.Core.csproj" />
    <ProjectReference Include="..\LanShare.Server\LanShare.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\assets\tools\7za.exe" Link="Tools\7za.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\assets\tools\7za.exe')" />
    <Content Include="..\..\assets\licenses\*" Link="Licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
