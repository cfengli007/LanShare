<pages:ShellPage x:Class="LanShare.Desktop.Pages.OverviewPage"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:pages="clr-namespace:LanShare.Desktop.Pages">
    <!--
      概览页：服务状态 / 访问地址 / 最近分享。
      只负责内容区；标题栏、菜单、状态条、底部按钮栏由 MainWindow 提供。
      底部按钮由 BuildActions() 生成（打开网页 + 新建分享），这里不再放重复按钮。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18,14,18,18">

            <!-- ================= 页头 ================= -->
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="概览" Style="{StaticResource PageTitle}" />
                <TextBlock Text="把文件快速分享给同一网络里的任何人，无需注册、无需客户端。"
                           Style="{StaticResource PageSubtitle}" Margin="0,5,0,0" />
            </StackPanel>

            <!-- ================= 1. 服务状态 ================= -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="服务状态" Style="{StaticResource SectionTitle}"
                                       VerticalAlignment="Center" Margin="0" />
                            <Border x:Name="StatusBadge" Style="{StaticResource BadgeAccent}" Margin="10,0,0,0">
                                <TextBlock x:Name="StatusBadgeText" Text="检测中"
                                           Style="{StaticResource BadgeTextAccent}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="RetryButton" Content="重试启动" Style="{StaticResource SmallButton}"
                                    Click="Retry_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                            <Button x:Name="RestartButton" Content="重启服务" Style="{StaticResource SmallButton}"
                                    Click="Restart_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- 页面内提示条（不用未交付的 InfoBanner，自己画） -->
                    <Border x:Name="ServiceBanner" Margin="0,12,0,0" CornerRadius="6"
                            Background="{DynamicResource OkSoft}" BorderBrush="{DynamicResource Ok}"
                            BorderThickness="3,0,0,0" Padding="11,8">
                        <StackPanel>
                            <TextBlock x:Name="ServiceBannerTitle" Text="服务状态" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Ok}" />
                            <TextBlock x:Name="ServiceBannerMessage" Text="正在初始化…"
                                       Style="{StaticResource HintText}" Margin="0,3,0,0"
                                       Foreground="{DynamicResource FgDim}" />
                        </StackPanel>
                    </Border>

                    <!-- 存储目录不可写警告：目录存在但没有写权限，或目录根本不存在时显示。
                         网页上传会直接 500，必须在界面上说清楚，否则用户完全看不出原因。 -->
                    <Border x:Name="StorageWarning" Margin="0,12,0,0" CornerRadius="6"
                            Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource Warn}"
                            BorderThickness="3,0,0,0" Padding="11,8" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="StorageWarningTitle" Text="存储目录不可写"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Warn}" />
                            <TextBlock x:Name="StorageWarningMessage" Text=""
                                       Style="{StaticResource HintText}" Margin="0,3,0,0"
                                       Foreground="{DynamicResource FgDim}" />
                        </StackPanel>
                    </Border>

                    <!-- 监听信息 -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="监听地址" Style="{StaticResource HintText}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock x:Name="ListenText" Grid.Column="1" Text="—"
                                   Style="{StaticResource Mono}" FontSize="12"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= 2. 访问地址 ================= -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="访问地址" Style="{StaticResource SectionTitle}" />

                    <TextBlock Text="内网地址" Style="{StaticResource FieldLabel}" Margin="0,2,0,5" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InternalUrlBox" Grid.Column="0" IsReadOnly="True"
                                 VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="复制" Style="{StaticResource SmallButton}"
                                Margin="8,0,0,0" Click="CopyInternal_Click" />
                        <Button Grid.Column="2" Content="打开" Style="{StaticResource SmallButton}"
                                Margin="6,0,0,0" Click="OpenInternal_Click" />
                    </Grid>

                    <TextBlock Text="外网地址" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ExternalUrlBox" Grid.Column="0" IsReadOnly="True"
                                 VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="复制" Style="{StaticResource SmallButton}"
                                Margin="8,0,0,0" Click="CopyExternal_Click" />
                        <Button Grid.Column="2" Content="打开" Style="{StaticResource SmallButton}"
                                Margin="6,0,0,0" Click="OpenExternal_Click" />
                    </Grid>

                    <TextBlock Text="外网地址未单独配置时会与内网地址一致，需要公网访问请到“设置 → 网络”里填写外网前缀。"
                               Style="{StaticResource HintText}" Margin="0,9,0,0" />
                </StackPanel>
            </Border>

            <!-- ================= 3. 最近分享 ================= -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="最近分享" Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center" Margin="0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="刷新" Style="{StaticResource SmallButton}"
                                    Click="Refresh_Click" Margin="0,0,8,0" />
                            <Button Content="查看全部" Style="{StaticResource SmallButton}"
                                    Click="ViewAll_Click" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl x:Name="RecentItems" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" Padding="0,9"
                                        BorderBrush="{DynamicResource LineSoft}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource HintText}" />
                                                <TextBlock Text=" · " Style="{StaticResource HintText}" />
                                                <TextBlock Text="{Binding RemainingText}" Style="{StaticResource HintText}" />
                                                <TextBlock Text=" · " Style="{StaticResource HintText}" />
                                                <TextBlock Text="{Binding SourceText}" Style="{StaticResource HintText}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="复制" Style="{StaticResource SmallButton}"
                                                    Tag="{Binding}" Click="CopyRecent_Click" Margin="0,0,6,0" />
                                            <Button Content="打开" Style="{StaticResource SmallButton}"
                                                    Tag="{Binding}" Click="OpenRecent_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空态 -->
                    <StackPanel x:Name="EmptyPanel" Margin="0,10,0,4" Visibility="Collapsed">
                        <TextBlock Text="还没有分享记录" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="点击下方“新建分享”，或在资源管理器里右键文件选择“用内网快传分享”。"
                                   Style="{StaticResource HintText}" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</pages:ShellPage>