<pages:ShellPage x:Class="LanShare.Desktop.Pages.SettingsPage"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:pages="clr-namespace:LanShare.Desktop.Pages">
    <!--
      设置页：6 个 Card（外观 / 网络 / 分享默认值 / 存储 / 系统集成 / 关于）。
      所有数字输入都是 TextBox（数字校验在代码里），不依赖 WPF-UI 的 NumberBox/ToggleSwitch。
      开关一律用 CheckBox —— App.xaml 已有自绘模板，深色下不会白底。
      底部按钮栏（重新载入 / 保存设置）由 BuildActions() 提供，页头不再重复。
    -->
    <ScrollViewer x:Name="PageScrollViewer" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18,14,18,18">

            <!-- ================= 页头 ================= -->
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
                <TextBlock Text="修改后点击底部“保存设置”，服务会按新配置重启。带 * 的设置需要管理员权限。"
                           Style="{StaticResource PageSubtitle}" Margin="0,5,0,0" />
            </StackPanel>

            <!-- ================= 页面内提示条 ================= -->
            <Border x:Name="PageBanner" Margin="0,0,0,12" CornerRadius="6" Padding="11,8"
                    Background="{DynamicResource OkSoft}" BorderBrush="{DynamicResource Ok}"
                    BorderThickness="3,0,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="PageBannerTitle" Text="" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Ok}" />
                        <TextBlock x:Name="PageBannerText" Text="" Style="{StaticResource HintText}"
                                   Margin="0,3,0,0" Foreground="{DynamicResource FgDim}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="关闭" Style="{StaticResource SmallButton}"
                            VerticalAlignment="Center" Margin="12,0,0,0" Click="CloseBanner_Click" />
                </Grid>
            </Border>

            <!-- ================= 危险操作二次确认（自绘，不用 MessageBox） ================= -->
            <Border x:Name="ConfirmBar" Margin="0,0,0,12" CornerRadius="6" Padding="11,8"
                    Background="{DynamicResource DangerSoft}" BorderBrush="{DynamicResource Danger}"
                    BorderThickness="3,0,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ConfirmMessageText" Grid.Column="0" Text="" FontSize="12"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="{DynamicResource Danger}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="确定" Style="{StaticResource SmallDangerButton}"
                                Click="ConfirmOk_Click" Margin="0,0,6,0" />
                        <Button Content="取消" Style="{StaticResource SmallButton}"
                                Click="ConfirmCancel_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= 1. 外观 ================= -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="外观" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="选择界面主题。跟随系统会在 Windows 切换深色/浅色模式时自动调整。"
                               Style="{StaticResource HintText}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="主题" Style="{StaticResource FieldLabel}" Margin="0" />
                            <TextBlock Text="切换后立即生效，保存后会写入配置文件。"
                                       Style="{StaticResource HintText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="180"
                                  VerticalAlignment="Center" SelectedIndex="0"
                                  SelectionChanged="ThemeCombo_SelectionChanged">
                            <ComboBoxItem Content="深色" Tag="Dark" />
                            <ComboBoxItem Content="浅色" Tag="Light" />
                            <ComboBoxItem Content="跟随系统" Tag="System" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= 2. 网络 ================= -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="网络" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="绑定 IP" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="BindAddressCombo" IsEditable="True" />
                            <TextBlock Text="0.0.0.0 表示监听所有网卡；也可填写本机某个 IP。"
                                       Style="{StaticResource HintText}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="端口" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="PortBox" Text="8910" PreviewTextInput="Digits_PreviewTextInput" />
                            <TextBlock Text="默认 8910。修改后需要重新放行防火墙。"
                                       Style="{StaticResource HintText}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                            <TextBlock Text="内网访问前缀" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="InternalBaseBox" />
                            <TextBlock Text="留空则自动使用本机内网 IP，例如 http://192.168.1.10:8910。"
                                       Style="{StaticResource HintText}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                            <TextBlock Text="外网访问前缀" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ExternalBaseBox" />
                            <TextBlock Text="例如 https://share.example.com。"
                                       Style="{StaticResource HintText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= 3. 分享默认值 ================= -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="分享默认值" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="默认有效期（分钟）" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="DefaultExpiryBox" Text="1440"
                                     PreviewTextInput="Digits_PreviewTextInput" />
                            <TextBlock Text="1440 分钟 = 1 天；右键菜单自动分享也使用该值。"
                                       Style="{StaticResource HintText}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="单次上传上限（MB）" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="MaxUploadBox" Text="2048"
                                     PreviewTextInput="Digits_PreviewTextInput" />
                            <TextBlock Text="网页端上传文件的单次最大体积。"
                                       Style="{StaticResource HintText}" Margin="0,4,0,0" />
                        </StackPanel>

                        <CheckBox x:Name="BurnToggle" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                  Content="新分享默认下载一次后失效（阅后即焚）" Margin="0,12,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= 4. 存储 ================= -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="存储" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="分享的文件与 7z 打包文件保存在该目录，终止分享时会删除对应文件。"
                               Style="{StaticResource HintText}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="StorageBox" Grid.Column="0" IsReadOnly="True" IsReadOnlyCaretVisible="True" />
                        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource FlatButton}"
                                Click="BrowseStorage_Click" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= 5. 系统集成 ================= -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="系统集成" Style="{StaticResource SectionTitle}" />

                    <CheckBox x:Name="LaunchAtStartupToggle" Content="开机时自动启动内网快传" Margin="0,2,0,0" />
                    <CheckBox x:Name="NotifyToggle" Content="创建分享后显示通知" Margin="0,10,0,0" />

                    <Border Style="{StaticResource RowSeparator}" Margin="0,14,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="资源管理器右键菜单" FontWeight="SemiBold" />
                            <TextBlock x:Name="ContextMenuStatusText" Text="未安装"
                                       Style="{StaticResource HintText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="安装" Style="{StaticResource SmallButton}"
                                    Click="InstallContextMenu_Click" Margin="0,0,6,0" />
                            <Button Content="卸载" Style="{StaticResource SmallDangerButton}"
                                    Click="UninstallContextMenu_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource RowSeparator}" Margin="0,12,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Windows 防火墙 *" FontWeight="SemiBold" />
                            <TextBlock x:Name="FirewallStatusText"
                                       Text="允许局域网设备访问分享端口（需要管理员权限）。"
                                       Style="{StaticResource HintText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="放行当前端口" Style="{StaticResource SmallButton}"
                                    Click="AllowFirewall_Click" Margin="0,0,6,0" />
                            <Button Content="移除规则" Style="{StaticResource SmallButton}"
                                    Click="RemoveFirewall_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource RowSeparator}" Margin="0,12,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="本机 IP 地址 *" FontWeight="SemiBold" />
                            <TextBlock Text="切换 DHCP 或设置静态 IP，需要管理员权限。"
                                       Style="{StaticResource HintText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="修改 IP…" Style="{StaticResource SmallButton}"
                                Click="ModifyIp_Click" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= 6. 关于 ================= -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="关于" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8"
                                Background="{DynamicResource CardFillHover}" Margin="0,0,12,0">
                            <TextBlock Text="LS" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Accent}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" Text="LanShare" FontWeight="SemiBold" />
                            <TextBlock Text="Windows 原生的局域网文件快传 — 桌面端建分享，任何设备用浏览器上传下载"
                                       Style="{StaticResource HintText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="项目主页" Style="{StaticResource SmallButton}"
                                    Click="OpenProject_Click" Margin="0,0,6,0" />
                            <Button Content="检查更新" Style="{StaticResource SmallButton}"
                                    Click="CheckUpdate_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="SaveStatusText" Style="{StaticResource HintText}" Margin="2,0,0,0" />
        </StackPanel>
    </ScrollViewer>
</pages:ShellPage>