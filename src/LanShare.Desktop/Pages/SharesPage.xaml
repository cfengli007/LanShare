<pages:ShellPage x:Class="LanShare.Desktop.Pages.SharesPage"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:pages="clr-namespace:LanShare.Desktop.Pages">
    <!--
      我的分享：一个 Card 里装表头 + 列表 + 空态。
      列表用 ListView（带虚拟化，分享多时不卡），行模板自绘，不依赖 WPF-UI。
      列宽固定，保证表头与行完全对齐；名称列用 * 吸收剩余宽度。
    -->
    <pages:ShellPage.Resources>
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="row" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource CardFillHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </pages:ShellPage.Resources>

    <ScrollViewer x:Name="PageScrollViewer" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18,14,18,18">

            <!-- ================= 页头 ================= -->
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="我的分享" Style="{StaticResource PageTitle}" />
                <TextBlock Text="这里列出桌面端与网页上传创建的全部分享。终止分享会立即删除对应的存储文件。"
                           Style="{StaticResource PageSubtitle}" Margin="0,5,0,0" />
            </StackPanel>

            <!-- 页面内提示条（错误/成功都用这一条，配色随状态换） -->
            <Border x:Name="PageBanner" Margin="0,0,0,12" CornerRadius="6" Padding="11,8"
                    Background="{DynamicResource DangerSoft}" BorderBrush="{DynamicResource Danger}"
                    BorderThickness="3,0,0,0" Visibility="Collapsed">
                <TextBlock x:Name="PageBannerText" Text="" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource Danger}" />
            </Border>

            <!-- 危险操作确认条：自绘，不弹 MessageBox（它不跟主题、不能复制） -->
            <Border x:Name="ConfirmBar" Margin="0,0,0,12" CornerRadius="6" Padding="11,8"
                    Background="{DynamicResource DangerSoft}" BorderBrush="{DynamicResource Danger}"
                    BorderThickness="3,0,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ConfirmText" Grid.Column="0" Text="" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource Danger}" VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="确认终止" Style="{StaticResource SmallDangerButton}"
                                Click="ConfirmRevoke_Click" Margin="0,0,6,0" />
                        <Button Content="取消" Style="{StaticResource SmallButton}"
                                Click="CancelConfirm_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 表头 -->
                    <Border Grid.Row="0" Padding="16,9" BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource Line}" CornerRadius="8,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="180" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="228" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="名称" Style="{StaticResource SectionTitle}" Margin="0" />
                            <TextBlock Grid.Column="1" Text="大小" Style="{StaticResource SectionTitle}" Margin="0" />
                            <TextBlock Grid.Column="2" Text="有效期" Style="{StaticResource SectionTitle}" Margin="0" />
                            <TextBlock Grid.Column="3" Text="下载" Style="{StaticResource SectionTitle}" Margin="0" />
                            <TextBlock Grid.Column="4" Text="来源" Style="{StaticResource SectionTitle}" Margin="0" />
                            <TextBlock Grid.Column="5" Text="操作" Style="{StaticResource SectionTitle}" Margin="0" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListView x:Name="SharesList" Background="Transparent" BorderThickness="0"
                                  Padding="0" Margin="0,2,0,2" MinHeight="80"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="Page_PreviewMouseWheel">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,9" BorderThickness="0,0,0,1"
                                            BorderBrush="{DynamicResource LineSoft}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="180" />
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="228" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding FileSummary}" Style="{StaticResource HintText}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="12"
                                                       VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RemainingText}" FontSize="12" />
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource HintText}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="3" Text="{Binding DownloadCountText}" FontSize="12"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="4" Text="{Binding SourceText}" FontSize="12"
                                                       VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="内链" Style="{StaticResource SmallButton}"
                                                        Tag="{Binding}" Click="CopyInternal_Click" Margin="0,0,5,0" />
                                                <Button Content="外链" Style="{StaticResource SmallButton}"
                                                        Tag="{Binding}" Click="CopyExternal_Click" Margin="0,0,5,0" />
                                                <Button Content="打开" Style="{StaticResource SmallButton}"
                                                        Tag="{Binding}" Click="Open_Click" Margin="0,0,5,0" />
                                                <Button Content="终止" Style="{StaticResource SmallDangerButton}"
                                                        Tag="{Binding}" Click="Revoke_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- 空态 -->
                        <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="0,34,0,34" Visibility="Collapsed">
                            <TextBlock Text="还没有分享" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="在“新建分享”里选择文件，或在资源管理器里右键文件选择“用内网快传分享”。"
                                       Style="{StaticResource HintText}" HorizontalAlignment="Center"
                                       TextAlignment="Center" MaxWidth="420" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <TextBlock x:Name="CountText" Style="{StaticResource HintText}" Margin="2,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</pages:ShellPage>