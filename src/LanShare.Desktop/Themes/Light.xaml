<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 语义化命名：换主题时不必改名。任何页面都只用这里的键，不要写死颜色。 -->
    <SolidColorBrush x:Key="Bg" Color="#F3F4F7"/>
    <SolidColorBrush x:Key="Panel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardFill" Color="#FAFBFC"/>
    <SolidColorBrush x:Key="CardFillHover" Color="#EEF1F6"/>
    <SolidColorBrush x:Key="Line" Color="#E2E5EB"/>
    <SolidColorBrush x:Key="LineSoft" Color="#EDEFF3"/>
    <SolidColorBrush x:Key="Fg" Color="#1C1F26"/>
    <SolidColorBrush x:Key="FgDim" Color="#5B6273"/>
    <SolidColorBrush x:Key="FgFaint" Color="#9AA0AE"/>
    <SolidColorBrush x:Key="Accent" Color="#2F6FE0"/>
    <SolidColorBrush x:Key="AccentDim" Color="#2F6FE0"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E8F0FE"/>
    <SolidColorBrush x:Key="Ok" Color="#1E8E5A"/>
    <SolidColorBrush x:Key="OkSoft" Color="#E3F5EC"/>
    <SolidColorBrush x:Key="Warn" Color="#B26A00"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#FDF1DE"/>
    <SolidColorBrush x:Key="Danger" Color="#C62828"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#FBE9E9"/>
    <SolidColorBrush x:Key="DangerHover" Color="#A81F1F"/>
    <SolidColorBrush x:Key="Input" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Popover" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Hint" Color="#FFF8E6"/>
    <SolidColorBrush x:Key="Overlay" Color="#D9FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarBg" Color="#F3F4F7"/>
    <SolidColorBrush x:Key="CaptionHover" Color="#E6EAF1"/>
    <SolidColorBrush x:Key="BtnBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BtnHover" Color="#F0F3F8"/>
    <SolidColorBrush x:Key="BtnPressed" Color="#E4EAF3"/>
    <SolidColorBrush x:Key="BtnBorder" Color="#E2E5EB"/>
    <SolidColorBrush x:Key="BtnBorderHover" Color="#CBD3E0"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#C6CCD8"/>
    <SolidColorBrush x:Key="TrackBg" Color="#E6EAF1"/>
    <SolidColorBrush x:Key="CheckBorder" Color="#B9C1D0"/>
    <SolidColorBrush x:Key="MenuHighlight" Color="#EAF0FA"/>
</ResourceDictionary>
