    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LanShare.Core\LanShare.Core.csproj" />
    <ProjectReference Include="..\..\src\LanShare.Server\LanShare.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\tools\7za.exe" Link="Tools\7za.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\assets\tools\7za.exe')" />
  </ItemGroup>

